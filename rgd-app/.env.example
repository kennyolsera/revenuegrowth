# Salin file ini menjadi .env.local (untuk development) dan isi juga
# sebagai Environment Variables di project Vercel Anda untuk production.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-supabase-anda

# Opsional — hanya diperlukan untuk fitur "Undang Pengguna" di menu User
# Management. JANGAN diberi awalan NEXT_PUBLIC_ (harus tetap rahasia di server).
# Ambil dari Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key-supabase-anda
